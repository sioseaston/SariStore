# Supabase (or swap for any Postgres host + your own client in src/lib/db.ts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Must match the LICENSE_HMAC_SECRET passed to the Flutter app at build time:
#   flutter build apk --dart-define=LICENSE_HMAC_SECRET=your-shared-secret
# Generate a strong random value, e.g.: openssl rand -hex 32
LICENSE_HMAC_SECRET=your-shared-secret-min-32-chars

# Admin dashboard session auth (simple example — swap for NextAuth/Clerk/etc. in production)
ADMIN_SESSION_SECRET=another-random-secret
